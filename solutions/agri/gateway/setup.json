{
  "gw": "AGRI",
  "devices": [
    {
      "id": "gh1",
      "name": "Nhà kính A",
      "fields": [
        {
          "key": "temp_c",
          "lbl": "Nhiệt độ",
          "unit": "°C",
          "widget": "gauge",
          "min": 0,
          "max": 50
        },
        {
          "key": "hum_pct",
          "lbl": "Độ ẩm KK",
          "unit": "%",
          "widget": "gauge",
          "min": 0,
          "max": 100
        },
        {
          "key": "soil_pct",
          "lbl": "Độ ẩm đất",
