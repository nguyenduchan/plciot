<Project Sdk="Microsoft.NET.Sdk">
  <!-- PLC giả lập (Windows): server Modbus TCP / Mitsubishi MC / Omron FINS cho gateway poll,
       và client MQTT đẩy telemetry schema:2 vào broker LAN của gateway C#. Độc lập với framework SCADA. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PlcSim</RootNamespace>
    <AssemblyName>PlcSim</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.376.244" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.376.244" />
  </ItemGroup>
</Project>
