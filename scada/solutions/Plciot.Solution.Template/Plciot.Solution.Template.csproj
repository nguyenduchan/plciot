<Project Sdk="Microsoft.NET.Sdk">

  <!-- MẪU TRỐNG cho một khách hàng mới: sao chép cả thư mục này, đổi tên (Plciot.Solution.<TenKhach>), sửa TemplateSolution.cs và SOLUTION.md.
       Chạy nền không giao diện; muốn giao diện thì làm IScadaUi (xem Plciot.Solution.Conveyor). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Plciot.Solution.Template</AssemblyName>
    <RootNamespace>Plciot.Solution.Template</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plciot.Scada.Framework\Plciot.Scada.Framework.csproj" />
  </ItemGroup>

</Project>
