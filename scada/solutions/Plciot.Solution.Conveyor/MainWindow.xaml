<Window x:Class="Plciot.Solution.Conveyor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA nhà máy" Height="640" Width="900" MinWidth="720" MinHeight="520">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style TargetType="TextBlock" x:Key="Kpi"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/></Style>
        <Style TargetType="TextBlock" x:Key="Cap"><Setter Property="Foreground" Value="Gray"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F2F4F7">
            <DockPanel>
                <TextBlock x:Name="CloudText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PlcText" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl Margin="8">
            <TabItem Header="Giám sát">
                <ScrollViewer><StackPanel Margin="12">
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource Cap}" Text="Băng tải"/><TextBlock x:Name="KConv" Style="{StaticResource Kpi}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Cap}" Text="Đếm hiện tại / mục tiêu"/><TextBlock x:Name="KCount" Style="{StaticResource Kpi}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Cap}" Text="Tổng đếm"/><TextBlock x:Name="KTotal" Style="{StaticResource Kpi}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Cap}" Text="Chế độ"/><TextBlock x:Name="KMode" Style="{StaticResource Kpi}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Cap}" Text="Thời gian chạy PLC"/><TextBlock x:Name="KRun" Style="{StaticResource Kpi}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Cap}" Text="Khởi động bơm"/><TextBlock x:Name="KPump" Style="{StaticResource Kpi}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Cap}" Text="Cảnh báo"/><WrapPanel x:Name="AlarmPanel" Margin="0,4,0,12"/>
                    <TextBlock Style="{StaticResource Cap}" Text="Đầu vào X"/><WrapPanel x:Name="XPanel" Margin="0,4,0,12"/>
                    <TextBlock Style="{StaticResource Cap}" Text="Đầu ra Y"/><WrapPanel x:Name="YPanel" Margin="0,4,0,12"/>
                    <TextBlock x:Name="SysText" Style="{StaticResource Cap}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Điều khiển">
                <ScrollViewer><StackPanel Margin="12">
                    <TextBlock x:Name="CtlHint" Style="{StaticResource Cap}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Chế độ" FontWeight="Bold"/>
                    <WrapPanel Margin="0,4,0,8">
                        <Button x:Name="BAuto" Content="Tự động" Click="OnAuto"/><Button x:Name="BMan" Content="Thủ công" Click="OnMan"/>
                    </WrapPanel>
                    <TextBlock Text="Đầu ra (chỉ ở chế độ thủ công)" FontWeight="Bold"/>
                    <WrapPanel x:Name="SwPanel" Margin="0,4,0,8"/>
                    <TextBlock Text="Băng tải" FontWeight="Bold"/>
                    <WrapPanel Margin="0,4,0,8">
                        <Button x:Name="BStart" Content="Chạy" Click="OnStart"/><Button x:Name="BStop" Content="Dừng" Click="OnStop"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Mục tiêu (0 = không giới hạn): " VerticalAlignment="Center"/>
                        <TextBox x:Name="TargetBox" Width="90" Margin="4,0,8,0"/>
                        <Button x:Name="BSetTarget" Content="Đặt" Click="OnSetTarget"/>
                        <Button x:Name="BReset" Content="Xoá số đếm" Click="OnReset"/>
                    </WrapPanel>
                    <TextBlock x:Name="AckText" Style="{StaticResource Cap}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Nhật ký"><TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="8"/></TabItem>
            <TabItem Header="Cài đặt">
                <ScrollViewer><StackPanel Margin="12" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="ModeText" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"/>
                    <TextBlock Text="Thiết bị" FontWeight="Bold"/>
                    <TextBlock Text="Mã nhà máy (site)"/><TextBox x:Name="SSite"/>
                    <TextBlock Text="Mã thiết bị"/><TextBox x:Name="SDevice"/>
                    <TextBlock Text="Nguồn dữ liệu PLC"/>
                    <ComboBox x:Name="SSource">
                        <ComboBoxItem Content="Gateway ESP32 (qua broker LAN)"/><ComboBoxItem Content="Modbus TCP"/>
                        <ComboBoxItem Content="Siemens S7"/><ComboBoxItem Content="Rockwell EtherNet/IP"/><ComboBoxItem Content="Mitsubishi MC"/>
                        <ComboBoxItem Content="Omron FINS"/><ComboBoxItem Content="Beckhoff ADS"/><ComboBoxItem Content="OPC UA"/>
                    </ComboBox>
                    <TextBlock Text="Địa chỉ PLC"/><TextBox x:Name="SHost"/>
                    <TextBlock Text="Cổng PLC (0 = mặc định của giao thức; tuỳ chọn riêng từng hãng sửa trong config.json)"/><TextBox x:Name="SPort"/>
                    <TextBlock Text="Điện thoại / Cloud (TLS) — chế độ xem/điều khiển do giải pháp quyết định" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="Máy chủ MQTT"/><TextBox x:Name="SCloudHost"/>
                    <TextBlock Text="Cổng (mqtts / wss)"/><TextBox x:Name="SCloudPort"/>
                    <TextBlock Text="Tài khoản"/><TextBox x:Name="SCloudUser"/>
                    <TextBlock Text="Mật khẩu"/><PasswordBox x:Name="SCloudPass" Margin="0,2,0,8" Padding="4"/>
                    <TextBlock Text="Ghim chứng chỉ SHA-256 (trống = xác thực bình thường)"/><TextBox x:Name="SPin"/>
                    <TextBlock x:Name="ScreensText" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,8"/>
                    <Button Content="Lưu và chạy lại ứng dụng" Click="OnSaveSettings" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="SettingsMsg" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
