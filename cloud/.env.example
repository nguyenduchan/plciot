# Copy to .env and paste the token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel
TUNNEL_TOKEN=

# App server (login + per-user webapp bundles). Min 16 random chars.
# openssl rand -hex 32
APP_JWT_SECRET=

# App listens on 127.0.0.1:3080. Point Cloudflare Tunnel hostname
# plc.dieukhientudong.net -> http://app:3080 (Docker network)

# Public HTTPS URL of the webapp (used in Telegram "Ä‘áº¿m Ä‘á»§" deep links)
WEBAPP_PUBLIC_URL=https://plc.dieukhientudong.net

# --- Telegram: dÃ¹ng CHUNG bot vá»›i D:\Project\mqtt_server ---
# CÃ¹ng TELEGRAM_BOT_TOKEN nhÆ° mqtt_server/.env
# mqtt_server/telegram_bot giá»¯ long-polling (/start + chia sáº» SÄT â†’ báº£ng telegram_users).
# plciot-app KHÃ”NG poll (TELEGRAM_BOT_POLLING=false): chá»‰ sendMessage OTP + thÃ´ng bÃ¡o Ä‘áº¿m Ä‘á»§,
