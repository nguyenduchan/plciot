JWT_TTL_HOURS=72
# CONTROL_REG_LIMITS=7:0-5000,4:0-255
# Nguá»“n káº¿t ná»‘i thÃªm cho CSP (ngoÃ i self, wss:, ws:)
# CSP_CONNECT_EXTRA=
# Háº¡n (ngÃ y) pháº£i báº­t vÃ¢n tay/Authenticator trÆ°á»›c khi bá»‹ khoÃ¡ Ä‘iá»u khiá»ƒn. "off" = khÃ´ng Ã©p.
CONTROL_ENROLL_GRACE_DAYS=3
# Proxy Ä‘Æ°á»£c tin khi Ä‘á»c CF-Connecting-IP / X-Forwarded-For (máº·c Ä‘á»‹nh: loopback + dáº£i riÃªng Docker/LAN)
TRUST_PROXY_CIDRS=
