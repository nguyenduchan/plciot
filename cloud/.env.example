# Copy to .env and paste the token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel
TUNNEL_TOKEN=

# App server (login + per-user webapp bundles). Min 16 random chars.
# openssl rand -hex 32
APP_JWT_SECRET=

# App listens on 127.0.0.1:3080. Point Cloudflare Tunnel hostname
# plc.dieukhientudong.net -> http://app:3080 (Docker network)

# Public HTTPS URL of the webapp (used in Telegram "đếm đủ" deep links)
WEBAPP_PUBLIC_URL=https://plc.dieukhientudong.net

# --- Telegram: dùng CHUNG bot với D:\Project\mqtt_server ---
# Cùng TELEGRAM_BOT_TOKEN như mqtt_server/.env
# mqtt_server/telegram_bot giữ long-polling (/start + chia sẻ SĐT → bảng telegram_users).
# plciot-app KHÔNG poll (TELEGRAM_BOT_POLLING=false): chỉ sendMessage OTP + thông báo đếm đủ,
# tra chat_id từ Postgres mqtt_server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_POLLING=false
TELEGRAM_NOTIFY_CHAT_IDS=

# Postgres của mqtt_server (container scada_db map 5432). Từ Docker plciot dùng host.docker.internal.
TELEGRAM_SHARED_PG_HOST=host.docker.internal
TELEGRAM_SHARED_PG_PORT=5432
TELEGRAM_SHARED_PG_USER=
TELEGRAM_SHARED_PG_PASSWORD=
TELEGRAM_SHARED_PG_DB=iot_postgres
# Hoặc một URL thay cho các biến trên:
# TELEGRAM_SHARED_DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/iot_postgres

# MQTT server ingest (read-only). Per-phone MQTT users are auto-provisioned into
# config/passwd + config/acl (scoped plc/<site>/<device>/# only).
#   mosquitto_passwd -b config/passwd ingest MATKHAU_INGEST
MQTT_NOTIFY_USER=ingest
MQTT_NOTIFY_PASS=

# Store every MQTT plc/+/+/* event on server; webapp syncs on open for offline charts
MQTT_INGEST=true
MQTT_INGEST_MIN_MS=0
# Mặc định 3 ngày; gói cao hơn đặt riêng từng user: node scripts/plan.js set <SĐT> <số ngày>=4|unlimited
HISTORY_DEFAULT_DAYS=3
# true = any logged-in user may read any site/dev (dev only)
HISTORY_OPEN_ACCESS=false

# CORS: comma-separated origins (defaults to WEBAPP_PUBLIC_URL if empty)
CORS_ORIGINS=https://plc.dieukhientudong.net

# Rate limits (per IP / minute)
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_OTP=5

# --- Đổi SĐT / khôi phục tài khoản (xem docs/ACCOUNT-RECOVERY.md) ---
# Email khôi phục (tuỳ chọn). Để trống = tắt kênh email.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Giám sát PLC <no-reply@example.com>"
# Chờ sau khi dùng mã khôi phục (giờ) / sau khi admin duyệt ticket (giờ) / email mới dùng được (giờ)
PHONE_CHANGE_COOLING_HOURS=24
RECOVERY_COOLING_HOURS=48
EMAIL_QUARANTINE_HOURS=72
# Các bit đầu vào X (D0) dùng cho thử thách "có mặt tại PLC" (tránh cảm biến đếm X3)
PLC_PROOF_BITS=0,1,2,4,5,6,7
RATE_LIMIT_SENSITIVE=8
