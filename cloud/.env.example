# MQTT server ingest (read-only). Per-phone MQTT users are auto-provisioned into
# config/passwd + config/acl (scoped plc/<site>/<device>/# and iot/<tenant>/â€¦ ).
#   mosquitto_passwd -b config/passwd ingest MATKHAU_INGEST
MQTT_NOTIFY_USER=ingest
MQTT_NOTIFY_PASS=

# --- Ná»n táº£ng Ä‘a tenant / MQTTS (docs/PARTNER-INTEGRATION.md) ---
# plc = giá»¯ topic gateway cÅ©; iot = chuáº©n partner má»›i. Dual = ACL+ingest cáº£ hai.
MQTT_PREFERRED_NS=plc
