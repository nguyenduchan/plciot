CONTROL_FROM_INTERNET=true
# CONTROL_LAN_CIDRS=203.0.113.0/24
# Webapp = cÃ¹ng subscribe cloud nhÆ° thiáº¿t bá»‹ (docs/ADMIN-REMOTE.md, SUBSCRIPTION-OPS.md)
SUBSCRIBE_REQUIRE_ACTIVATION=true
# false = khÃ´ng tá»± nháº­n gÃ³i khi Ä‘Äƒng kÃ½; admin kÃ­ch hoáº¡t tay trÃªn Console / plan.js
SUBSCRIBE_AUTO_GRANT=false
