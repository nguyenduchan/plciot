# CF_ACCESS_ALLOW_EMAILS=ban@example.com
# Ingest chá»‰ lÆ°u gÃ³i tin cá»§a thiáº¿t bá»‹/user Ä‘Ã£ Ä‘Äƒng kÃ½ + gÃ³i cÃ²n háº¡n (docs/DEVICE-BINDING.md)
INGEST_REQUIRE_KNOWN=true
