FIRST_DEVICE_ONLY=false
# PC tráº¡m táº¡i xÆ°á»Ÿng: IP cÃ´ng cá»™ng/dáº£i cá»§a xÆ°á»Ÿng (phÃ¢n tÃ¡ch dáº¥u pháº©y), káº¿t há»£p khoÃ¡ tráº¡m do admin cáº¥p
CONTROL_LAN_CIDRS=
