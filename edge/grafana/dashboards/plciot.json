{
 "uid": "plciot-main",
 "title": "Giám sát PLC",
 "tags": [
  "plciot"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": false,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "bucket",
    "type": "constant",
    "query": "plc",
    "hide": 2
   },
   {
    "name": "site",
    "label": "Nhà máy",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "plciot-influx"
    },
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"site\")",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false
   },
   {
    "name": "device",
    "label": "Thiết bị",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "plciot-influx"
    },
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"device\", predicate: (r) => r.site == \"${site}\")",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "PLC",
   "type": "stat",
   "datasource": {
    "type": "influxdb",
    "uid": "plciot-influx"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "plciot-influx"
     },
     "query": "from(bucket: \"${bucket}\") |> range(start: -2m) |> filter(fn: (r) => r._measurement == \"plc_status\" and r._field == \"online\" and r.site == \"${site}\" and r.device == \"${device}\") |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Mất kết nối",
         "color": "red"
        },
        "1": {
         "text": "Online",
         "color": "green"
        }
       }
      }
     ],
     "noValue": "Mất kết nối",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
