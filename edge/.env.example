# Copy to edge/.env  (không commit). Dùng mật khẩu dài, khác nhau.
TZ=Asia/Ho_Chi_Minh

# InfluxDB 2 (lưu chuỗi thời gian). Chỉ nghe loopback.
INFLUX_ADMIN_USER=plciot
INFLUX_ADMIN_PASSWORD=
INFLUX_TOKEN=            # openssl rand -hex 32
INFLUX_ORG=plciot
INFLUX_BUCKET=plc
INFLUX_RETENTION=90d

# Grafana (xem/giám sát trong LAN nhà máy, cổng 3000)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# Giao diện điều khiển web của Node-RED (http://<ip>:1880/scada) — tài khoản dạng user:vai trò:mật khẩu, cách nhau bằng ;
# vai trò: operator (xem + điều khiển) | viewer (chỉ xem)
SCADA_USERS=operator:operator:;viewer:viewer:
SCADA_ALLOW_REMOTE=false

# Cổng máy chủ giao thức công nghiệp mà PC nhà máy lắng nghe (để HMI/MES khác đọc dữ liệu)
MODBUS_SERVER_PORT=1502
OPCUA_SERVER_PORT=4840
